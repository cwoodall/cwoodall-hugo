{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    { "name": "project-words", "path": "./.cspell/project-words.txt", "addWords": true }
  ],
  "dictionaries": ["project-words", "en_US", "softwareTerms", "companies", "names", "cpp", "python", "bash"],
  "files": ["content/**/*.md", "README.md"],
  "ignorePaths": ["themes/**", "public/**", "resources/**", "static/**", ".vale/**", "node_modules/**"],
  "ignoreRegExpList": [
    "/\\{\\{[<%][\\s\\S]*?[%>]\\}\\}/g",
    "/<[a-z][^>]*>/gi",
    "/```[\\s\\S]*?```/g",
    "/\\]\\([^)]*\\)/g",
    "/^image:.*$/gm"
  ]
}
