{
    // Spelling words live in cspell.json / .cspell/project-words.txt so the
    // pre-commit hook and this editor share one dictionary.
    "grammarly.selectors": [
        {
            "language": "markdown",
            "scheme": "file",
            "pattern": "content/**/*.md"
        },
        {
            "language": "markdown",
            "scheme": "file",
            "pattern": "README.md"
        }
    ]
}
